{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/callouts/**",
              "components/concepts/**",
              "components/diagrams/**",
              "components/flashcards/**",
              "components/flow/**",
              "components/media/**",
              "components/structure/**",
              "components/tables/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Merriweather|Lexend|Fira Code))/i]",
        "message": "Font not provided by the design system. Available: Merriweather, Lexend, Fira Code."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:chapter|label|children|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: chapter, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chain'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|chapter|connector|key|ref|className|style|children)$/]",
        "message": "<Chain> doesn't accept that prop. Declared props: items, chapter, connector."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chain'] > JSXAttribute[name.name='connector'] > Literal[value!=/^(?:→|=|\\+|⇒)$/]",
        "message": "<Chain> connector must be one of '→' | '=' | '+' | '⇒'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChapterHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|week|chapterNumber|chapter|title|subtitle|topics|key|ref|className|style|children)$/]",
        "message": "<ChapterHeader> doesn't accept that prop. Declared props: eyebrow, week, chapterNumber, chapter, title, subtitle, topics."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|chapter|key|ref|className|style|children)$/]",
        "message": "<ComparisonTable> doesn't accept that prop. Declared props: columns, rows, chapter."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConceptCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:term|definition|formulas|breakdown|why|chapter|key|ref|className|style|children)$/]",
        "message": "<ConceptCard> doesn't accept that prop. Declared props: term, definition, formulas, breakdown, why, chapter."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlashCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|definition|formula|why|chapter|key|ref|className|style|children)$/]",
        "message": "<FlashCard> doesn't accept that prop. Declared props: number, title, definition, formula, why, chapter."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowchartNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|shape|filled|children|key|ref|className|style|children)$/]",
        "message": "<FlowchartNode> doesn't accept that prop. Declared props: label, shape, filled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowchartNode'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:box|diamond)$/]",
        "message": "<FlowchartNode> shape must be one of 'box' | 'diamond'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormulaTreeNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|op|filled|tint|children|key|ref|className|style|children)$/]",
        "message": "<FormulaTreeNode> doesn't accept that prop. Declared props: value, label, op, filled, tint, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormulaTreeNode'] > JSXAttribute[name.name='op'] > Literal[value!=/^(?:×|÷|\\+|−)$/]",
        "message": "<FormulaTreeNode> op must be one of '×' | '÷' | '+' | '−'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Image'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|ratio|chapter|key|ref|className|style|children)$/]",
        "message": "<Image> doesn't accept that prop. Declared props: src, alt, caption, ratio, chapter."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyTermsTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:terms|chapter|key|ref|className|style|children)$/]",
        "message": "<KeyTermsTable> doesn't accept that prop. Declared props: terms, chapter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Matrix'] > JSXAttribute > JSXIdentifier[name!=/^(?:rowLabels|colLabels|cells|chapter|key|ref|className|style|children)$/]",
        "message": "<Matrix> doesn't accept that prop. Declared props: rowLabels, colLabels, cells, chapter."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:week|label|chapter|key|ref|className|style|children)$/]",
        "message": "<PageBadge> doesn't accept that prop. Declared props: week, label, chapter."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:chapterLabel|page|totalPages|key|ref|className|style|children)$/]",
        "message": "<PageFooter> doesn't accept that prop. Declared props: chapterLabel, page, totalPages."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:chapter|title|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: chapter, title, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:chapter|children|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: chapter, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitSide'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|chapter|key|ref|className|style|children)$/]",
        "message": "<SplitSide> doesn't accept that prop. Declared props: title, items, chapter."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepPipeline'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|chapter|key|ref|className|style|children)$/]",
        "message": "<StepPipeline> doesn't accept that prop. Declared props: steps, chapter."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopicHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:topicNumber|title|kicker|key|ref|className|style|children)$/]",
        "message": "<TopicHeader> doesn't accept that prop. Declared props: topicNumber, title, kicker."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkedExampleStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|lines|key|ref|className|style|children)$/]",
        "message": "<WorkedExampleStep> doesn't accept that prop. Declared props: label, lines."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
